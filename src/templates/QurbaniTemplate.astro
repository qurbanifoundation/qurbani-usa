  <script is:inline>
    // Category Tab Filtering
    var countriesGrid = document.getElementById('countries-grid');
    document.querySelectorAll('.category-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        // Update active tab
        document.querySelectorAll('.category-tab').forEach(t => {
          t.classList.remove('active', 'bg-[#01534d]', 'text-white');
          t.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:bg-gray-100');
        });
        tab.classList.add('active', 'bg-[#01534d]', 'text-white');
        tab.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:bg-gray-100');

        var category = tab.dataset.category;

        // Filter countries
        document.querySelectorAll('.country-card').forEach(card => {
          var categories = card.dataset.categories.split(',');
          if (category === 'all' || categories.includes(category)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // Sort: lowest-price by price ascending, everything else alphabetical
        if (countriesGrid) {
          var cards = Array.from(countriesGrid.querySelectorAll('.country-card'));
          if (category === 'lowest-price') {
            cards.sort(function(a, b) {
              return (parseFloat(a.dataset.minPrice) || 999) - (parseFloat(b.dataset.minPrice) || 999);
            });
          } else {
            // Alphabetical by country name
            cards.sort(function(a, b) {
              var nameA = (a.dataset.countryName || '').trim();
              var nameB = (b.dataset.countryName || '').trim();
              return nameA.localeCompare(nameB);
            });
          }
          cards.forEach(function(card) { countriesGrid.appendChild(card); });
        }
      });
    });

    // Desktop Country Search — Airbnb-style instant dropdown
    (function() {
      const searchInput = document.getElementById('country-search');
      const searchIconBtn = document.getElementById('country-search-icon');
      const searchWrap = document.getElementById('desktop-search-wrap');
      const dropdown = document.getElementById('desktop-search-dropdown');
      const resultsEl = document.getElementById('desktop-search-results');
      const emptyEl = document.getElementById('desktop-search-empty');
      const clearBtn = document.getElementById('country-search-clear');
      if (!searchInput || !dropdown || !resultsEl) return;

      // Build a static country list from the rendered cards (so it auto-syncs with DB).
      function getCountryList() {
        return Array.from(document.querySelectorAll('.country-card')).map(card => {
          const id = card.dataset.country || '';
          const name = (card.dataset.countryName || '').trim();
          const img = card.querySelector('img')?.getAttribute('src') || '';
          const flag = (card.querySelector('span.text-3xl')?.textContent || '').trim();
          const minPrice = parseFloat(card.dataset.minPrice || '0');
          const cats = (card.dataset.categories || '').split(',');
          const isPopular = card.dataset.popular === 'true';
          const featured = cats.includes('most-needed') || cats.includes('emergency');
          return { id, name, img, flag, minPrice, featured, isPopular };
        });
      }

      // "Most Popular" = admin-flagged countries, sorted by price (highest first).
      // Falls back to top 6 by price if admin hasn't flagged any.
      function getPopular(all) {
        const flagged = all.filter(c => c.isPopular);
        const sortByPrice = (a, b) => (b.minPrice || 0) - (a.minPrice || 0);
        if (flagged.length > 0) return flagged.slice().sort(sortByPrice);
        return all.slice().sort(sortByPrice).slice(0, 6);
      }

      function renderDropdown(query) {
        const all = getCountryList();
        const q = (query || '').toLowerCase().trim();

        let matches = all;
        if (q) {
          matches = all.filter(c =>
            c.name.toLowerCase().includes(q) || c.id.toLowerCase().includes(q)
          );
        }

        if (matches.length === 0) {
          resultsEl.innerHTML = '';
          emptyEl.classList.remove('hidden');
          return;
        }
        emptyEl.classList.add('hidden');

        let html = '';
        if (!q) {
          // Section: Most Popular (top 6 by price)
          const popular = getPopular(all);
          if (popular.length) {
            html += '<div class="px-5 pt-4 pb-2 flex items-center gap-2"><span class="text-[11px] font-bold tracking-wider text-[#D97718] uppercase">★ Most Popular</span><span class="text-[10px] text-gray-400">— Donor favorites</span></div>';
            html += '<div class="bg-gradient-to-b from-[#D97718]/5 to-transparent">';
            html += popular.map(c => buildRow(c, true)).join('');
            html += '</div>';
            html += '<div class="border-t border-gray-100 my-1"></div>';
          }
          // Section: All Countries
          html += '<div class="px-5 pt-3 pb-2 text-[11px] font-bold tracking-wider text-gray-400 uppercase">All Countries</div>';
          const sorted = all.slice().sort((a, b) => a.name.localeCompare(b.name));
          html += sorted.map(c => buildRow(c, false)).join('');
        } else {
          html += '<div class="px-5 pt-4 pb-2 text-[11px] font-bold tracking-wider text-gray-400 uppercase">' + matches.length + ' result' + (matches.length === 1 ? '' : 's') + '</div>';
          html += matches.slice().sort((a, b) => a.name.localeCompare(b.name)).map(c => buildRow(c, false)).join('');
        }
        resultsEl.innerHTML = html;

        // Wire row clicks
        resultsEl.querySelectorAll('.dsk-search-row').forEach(row => {
          row.addEventListener('click', () => {
            const id = row.getAttribute('data-id') || '';
            selectCountry(id);
          });
        });
      }

      function buildRow(c, isPopular) {
        const safeName = (c.name || '').replace(/"/g, '&quot;');
        const img = c.img
          ? '<img src="' + c.img + '" alt="" width="40" height="40" loading="lazy" class="w-10 h-10 rounded-lg object-cover flex-shrink-0" />'
          : '<div class="w-10 h-10 rounded-lg bg-gray-100 flex-shrink-0"></div>';
        const badge = isPopular
          ? '<span class="ml-2 text-[10px] font-bold text-[#D97718] bg-[#D97718]/10 px-1.5 py-0.5 rounded">POPULAR</span>'
          : '';
        return ''
          + '<button type="button" class="dsk-search-row w-full flex items-center gap-3 px-5 py-2.5 hover:bg-gray-50 transition cursor-pointer text-left" data-id="' + c.id + '">'
          + img
          + '<div class="flex-1 min-w-0 flex items-center gap-2">'
          + (c.flag ? '<span class="text-lg">' + c.flag + '</span>' : '')
          + '<span class="font-semibold text-gray-800 truncate">' + safeName + '</span>'
          + badge
          + '</div>'
          + '<span class="text-sm font-bold text-[#01534d] flex-shrink-0">From $' + (c.minPrice || 0) + '</span>'
          + '</button>';
      }

      function selectCountry(id) {
        const card = document.querySelector('.country-card[data-country="' + id + '"]');
        closeDropdown();
        if (!card) return;

        // Make sure the card is visible — switch to "All" tab so all cards show.
        const allTab = document.querySelector('[data-category="all"]');
        if (allTab) allTab.click();
        // Then scroll + pulse highlight
        setTimeout(() => {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          card.classList.add('ring-4', 'ring-[#D97718]', 'ring-offset-2');
          setTimeout(() => card.classList.remove('ring-4', 'ring-[#D97718]', 'ring-offset-2'), 2000);
        }, 50);

        // Reset search input
        searchInput.value = '';
        if (clearBtn) clearBtn.classList.add('hidden');
      }

      function openDropdown() {
        renderDropdown(searchInput.value);
        dropdown.style.display = 'block';
        searchInput.placeholder = 'Search Qurbani Country';
      }
      function closeDropdown() {
        dropdown.style.display = 'none';
        searchInput.placeholder = 'Search Qurbani Country';
      }

      // Open on focus / icon click
      searchInput.addEventListener('focus', openDropdown);
      searchInput.addEventListener('click', openDropdown);
      if (searchIconBtn) {
        searchIconBtn.addEventListener('click', () => {
          searchInput.focus();
          openDropdown();
        });
      }

      // Filter as user types
      searchInput.addEventListener('input', () => {
        if (clearBtn) {
          clearBtn.classList.toggle('hidden', searchInput.value.length === 0);
        }
        renderDropdown(searchInput.value);
        if (dropdown.style.display !== 'block') openDropdown();
      });

      // Clear button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          clearBtn.classList.add('hidden');
          renderDropdown('');
          searchInput.focus();
        });
      }

      // Close on outside click / Esc
      document.addEventListener('click', (e) => {
        if (!searchWrap.contains(e.target)) closeDropdown();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDropdown();
      });
    })();

    // ─── MOBILE FULLSCREEN SEARCH ───────────────────────────────────────
    var mobileSearchTrigger = document.getElementById('mobile-search-trigger');
    var mobileSearchOverlay = document.getElementById('mobile-search-overlay');
    var mobileSearchInput = document.getElementById('mobile-country-search');
    var mobileSearchClear = document.getElementById('mobile-search-clear');
    var mobileSearchCancel = document.getElementById('mobile-search-cancel');
    var mobileSearchResults = document.getElementById('mobile-search-results');

    // Build country list from DOM
    function getCountryList() {
      var cards = document.querySelectorAll('.country-card[data-country]');
      var list = [];
      cards.forEach(function(card) {
        var id = card.getAttribute('data-country') || '';
        var name = card.getAttribute('data-country-name') || id;
        var img = card.querySelector('img');
        var imgSrc = img ? img.getAttribute('src') : '';
        var minPrice = card.getAttribute('data-min-price') || '';
        var isPopular = card.getAttribute('data-popular') === 'true';
        var badges = [];
        card.querySelectorAll('.badge-pill, [class*="rounded-full"][class*="text-xs"]').forEach(function(b) {
          var t = b.textContent.trim();
          if (t && t.length < 20) badges.push(t);
        });
        list.push({ id: id, name: name, image: imgSrc, minPrice: minPrice, isPopular: isPopular, badges: badges });
      });
      return list;
    }

    // Track the visual viewport to keep the overlay sized to the visible area
    // (above the iOS keyboard) so the input bar stays at the top, never hidden.
    function syncOverlayToViewport() {
      if (!mobileSearchOverlay) return;
      var vv = window.visualViewport;
      if (vv) {
        mobileSearchOverlay.style.height = vv.height + 'px';
        mobileSearchOverlay.style.top = vv.offsetTop + 'px';
      } else {
        mobileSearchOverlay.style.height = '100vh';
        mobileSearchOverlay.style.top = '0px';
      }
    }
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', syncOverlayToViewport);
      window.visualViewport.addEventListener('scroll', syncOverlayToViewport);
    }

    function openMobileSearch() {
      if (!mobileSearchOverlay) return;
      mobileSearchOverlay.style.display = 'flex';
      mobileSearchOverlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      syncOverlayToViewport();
      // Populate all countries initially
      renderMobileResults('');
      // Focus input after animation, then sync once more once the keyboard is up
      setTimeout(function() {
        if (mobileSearchInput) mobileSearchInput.focus();
        // Give iOS keyboard time to animate, then re-sync overlay
        setTimeout(syncOverlayToViewport, 300);
      }, 100);
    }

    function closeMobileSearch() {
      if (!mobileSearchOverlay) return;
      mobileSearchOverlay.style.display = 'none';
      mobileSearchOverlay.classList.add('hidden');
      document.body.style.overflow = '';
      if (mobileSearchInput) mobileSearchInput.value = '';
      if (mobileSearchClear) mobileSearchClear.classList.add('hidden');
      // Clear hero-origin flag if user cancels without picking
      window.__heroOriginatedSearch = false;
    }

    // Most Popular = admin-flagged countries, sorted by price (highest first).
    function getMobilePopular(all) {
      function sortByPrice(a, b) { return (parseFloat(b.minPrice) || 0) - (parseFloat(a.minPrice) || 0); }
      var flagged = all.filter(function(c) { return c.isPopular; });
      if (flagged.length > 0) return flagged.slice().sort(sortByPrice);
      return all.slice().sort(sortByPrice).slice(0, 6);
    }

    function buildMobileRow(c, isPopular) {
      var badgeHtml = '';
      if (isPopular) {
        badgeHtml = '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#D97718]/10 text-[#D97718] flex-shrink-0">POPULAR</span>';
      } else if (c.badges && c.badges.length > 0) {
        badgeHtml = c.badges.map(function(b) {
          var color = b.toLowerCase().indexOf('urgent') >= 0 ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700';
          return '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full ' + color + ' flex-shrink-0">' + b + '</span>';
        }).join(' ');
      }
      var priceHtml = c.minPrice ? '<span class="text-sm text-gray-500">From <strong class="text-[#01534d]">$' + c.minPrice + '</strong></span>' : '';
      return '<button type="button" class="mobile-country-result w-full flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-gray-50 active:bg-gray-100 transition text-left border-b border-gray-50" data-country-id="' + c.id + '">'
        + '<div class="w-14 h-10 rounded-lg overflow-hidden bg-gray-100 flex-shrink-0">'
        + (c.image ? '<img src="' + c.image + '" alt="" width="48" height="48" loading="lazy" decoding="async" class="w-full h-full object-cover" />' : '')
        + '</div>'
        + '<div class="flex-1 min-w-0">'
        + '<div class="flex items-center gap-2 min-w-0">'
        + '<span class="font-semibold text-gray-800 text-base truncate">' + c.name + '</span>'
        + (badgeHtml || '')
        + '</div>'
        + (priceHtml ? '<div class="mt-0.5">' + priceHtml + '</div>' : '')
        + '</div>'
        + '<svg class="w-5 h-5 text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>'
        + '</button>';
    }

    function renderMobileResults(query) {
      if (!mobileSearchResults) return;
      var allCountries = getCountryList();
      var q = query.toLowerCase().trim();

      // Empty query → show "Most Popular" + "All Countries" (alphabetical), like desktop
      if (q.length === 0) {
        var html = '';
        var popular = getMobilePopular(allCountries);
        if (popular.length) {
          html += '<div class="px-2 pt-3 pb-2 flex items-center gap-2"><span class="text-[11px] font-bold tracking-wider text-[#D97718] uppercase">★ Most Popular</span><span class="text-[10px] text-gray-400">— Donor favorites</span></div>';
          html += '<div class="bg-gradient-to-b from-[#D97718]/5 to-transparent rounded-xl p-1 mb-2">';
          html += popular.map(function(c) { return buildMobileRow(c, true); }).join('');
          html += '</div>';
        }
        html += '<div class="px-2 pt-2 pb-2 text-[11px] font-bold tracking-wider text-gray-400 uppercase">All Countries</div>';
        var sorted = allCountries.slice().sort(function(a, b) { return a.name.localeCompare(b.name); });
        html += sorted.map(function(c) { return buildMobileRow(c, false); }).join('');
        mobileSearchResults.innerHTML = html;
      } else {
        var filtered = allCountries
          .filter(function(c) { return c.name.toLowerCase().indexOf(q) >= 0 || c.id.toLowerCase().indexOf(q) >= 0; })
          .sort(function(a, b) { return a.name.localeCompare(b.name); });
        if (filtered.length === 0) {
          mobileSearchResults.innerHTML = '<div class="flex flex-col items-center justify-center py-16 text-gray-400"><svg class="w-12 h-12 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg><p class="font-medium">No countries found</p><p class="text-sm mt-1">Try a different search term</p></div>';
          return;
        }
        var html = '<div class="px-2 pt-3 pb-2 text-[11px] font-bold tracking-wider text-gray-400 uppercase">' + filtered.length + ' result' + (filtered.length === 1 ? '' : 's') + '</div>';
        html += filtered.map(function(c) { return buildMobileRow(c, false); }).join('');
        mobileSearchResults.innerHTML = html;
      }

      // Bind click on results to scroll to country card and close overlay
      mobileSearchResults.querySelectorAll('.mobile-country-result').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var countryId = btn.getAttribute('data-country-id');
          // If this overlay was opened from the hero quick-donate box, populate that
          // box's selection instead of scrolling to the country card.
          if (window.__heroOriginatedSearch && typeof window.__heroQuickDonateApply === 'function') {
            var card = document.querySelector('[data-country="' + countryId + '"]');
            var price = card ? parseFloat(card.getAttribute('data-min-price') || '0') : 0;
            var name = card ? (card.getAttribute('data-country-name') || '').trim() : '';
            var flagEl = card ? card.querySelector('span.text-3xl') : null;
            var flag = flagEl ? flagEl.textContent.trim() : '';
            var img = card && card.querySelector('img') ? card.querySelector('img').getAttribute('src') : '';
            window.__heroQuickDonateApply({ id: countryId, name: name, price: price, flag: flag, image: img });
            window.__heroOriginatedSearch = false;
            closeMobileSearch();
            return;
          }
          closeMobileSearch();
          // Find and scroll to the country card
          var card = document.querySelector('[data-country="' + countryId + '"]');
          if (card) {
            // Make sure it's visible (remove hidden if filtered)
            card.classList.remove('hidden');
            // Reset category filter to show all
            document.querySelectorAll('.category-tab').forEach(function(t) {
              t.classList.remove('active', 'bg-[#01534d]', 'text-white');
              t.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
            });
            var allTab = document.querySelector('[data-category="all"]');
            if (allTab) {
              allTab.classList.add('active', 'bg-[#01534d]', 'text-white');
              allTab.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
            }
            // Show all cards
            document.querySelectorAll('[data-country]').forEach(function(c) { c.classList.remove('hidden'); });
            // Scroll to the card
            setTimeout(function() {
              card.scrollIntoView({ behavior: 'smooth', block: 'center' });
              // Highlight briefly
              card.style.boxShadow = '0 0 0 3px #01534d';
              setTimeout(function() { card.style.boxShadow = ''; }, 2000);
            }, 200);
          }
        });
      });
    }

    // Open fullscreen search
    if (mobileSearchTrigger) {
      mobileSearchTrigger.addEventListener('click', openMobileSearch);
    }

    // Cancel
    if (mobileSearchCancel) {
      mobileSearchCancel.addEventListener('click', closeMobileSearch);
    }

    // Clear X button
    if (mobileSearchClear) {
      mobileSearchClear.addEventListener('click', function() {
        if (mobileSearchInput) mobileSearchInput.value = '';
        mobileSearchClear.classList.add('hidden');
        renderMobileResults('');
        mobileSearchInput.focus();
      });
    }

    // Search input
    if (mobileSearchInput) {
      mobileSearchInput.addEventListener('input', function() {
        var val = mobileSearchInput.value;
        if (mobileSearchClear) {
          if (val.length > 0) mobileSearchClear.classList.remove('hidden');
          else mobileSearchClear.classList.add('hidden');
        }
        renderMobileResults(val);
      });

      // Enter dismisses keyboard
      mobileSearchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          mobileSearchInput.blur();
        }
      });
    }

    // Animal Type Pill Selection
    document.querySelectorAll('.animal-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const card = pill.closest('.country-card');

        // Update pill styles
        card.querySelectorAll('.animal-pill').forEach(p => {
          p.classList.remove('border-[#01534d]', 'bg-[#01534d]/5', 'text-[#01534d]');
          p.classList.add('border-gray-200', 'text-gray-600');
        });
        pill.classList.remove('border-gray-200', 'text-gray-600');
        pill.classList.add('border-[#01534d]', 'bg-[#01534d]/5', 'text-[#01534d]');

        // Update price
        updateCardPrice(card);
      });
    });

    // Quantity Controls
    document.querySelectorAll('.qty-minus').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.country-card');
        const input = card.querySelector('.qty-input');
        const currentVal = parseInt(input.value) || 1;
        if (currentVal > 1) {
          input.value = currentVal - 1;
          updateCardPrice(card);
        }
      });
    });

    document.querySelectorAll('.qty-plus').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.country-card');
        const input = card.querySelector('.qty-input');
        const currentVal = parseInt(input.value) || 1;
        if (currentVal < 100) {
          input.value = currentVal + 1;
          updateCardPrice(card);
        }
      });
    });

    document.querySelectorAll('.qty-input').forEach(input => {
      input.addEventListener('change', (e) => {
        const card = e.target.closest('.country-card');
        let val = parseInt(e.target.value) || 1;
        if (val < 1) val = 1;
        if (val > 100) val = 100;
        e.target.value = val;
        updateCardPrice(card);
      });
    });

    function updateCardPrice(card) {
      const selectedPill = card.querySelector('.animal-pill.border-\\[\\#01534d\\]');
      if (!selectedPill) return;
      const unitPrice = parseInt(selectedPill.dataset.price);
      const qty = parseInt(card.querySelector('.qty-input').value) || 1;
      card.querySelector('.country-price').textContent = (unitPrice * qty).toLocaleString();
    }

    // Dedicate Toggle
    document.querySelectorAll('.behalf-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.country-card');
        const container = card.querySelector('.behalf-container');
        const input = card.querySelector('.behalf-input');
        container.classList.remove('hidden');
        btn.classList.add('hidden');

        const isMobile = window.matchMedia('(max-width: 767px)').matches;
        if (isMobile) {
          // Wait for the input to render + keyboard to start opening, then center it.
          input.focus();
          setTimeout(() => {
            input.scrollIntoView({ block: 'center', behavior: 'smooth' });
          }, 250);
        } else {
          input.focus({ preventScroll: true });
        }
      });
    });

    // Also handle direct taps on the input (e.g. user taps after dismissing keyboard).
    document.querySelectorAll('.behalf-input').forEach(input => {
      input.addEventListener('focus', () => {
        const isMobile = window.matchMedia('(max-width: 767px)').matches;
        if (!isMobile) return;
        // Delay so the on-screen keyboard has time to appear before we measure.
        setTimeout(() => {
          input.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }, 250);
      });
    });

    // Dedicate Clear/Close
    document.querySelectorAll('.behalf-clear').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.country-card');
        const container = card.querySelector('.behalf-container');
        const toggle = card.querySelector('.behalf-toggle');
        card.querySelector('.behalf-input').value = '';
        container.classList.add('hidden');
        toggle.classList.remove('hidden');
      });
    });

    // Reset an Add button back to its default orange "+ Add" state
    function resetQurbaniAddButton(btn) {
      if (!btn) return;
      if (btn._resetTimer) { clearTimeout(btn._resetTimer); btn._resetTimer = null; }
      btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg> Add to Donation`;
      btn.classList.remove('bg-green-500');
    }

    // When the cart modal closes, immediately reset any Add buttons that are
    // still in the green "Added!" state — so when the user scrolls back to the
    // country card they see the normal orange button (no green→orange flash).
    (function() {
      var ggCheckout = document.getElementById('gg-checkout');
      if (!ggCheckout) return;
      var wasOpen = !ggCheckout.classList.contains('hidden');
      var obs = new MutationObserver(function() {
        var open = !ggCheckout.classList.contains('hidden');
        if (wasOpen && !open) {
          // Just closed — reset any green Add buttons
          document.querySelectorAll('.add-qurbani-btn.bg-green-500').forEach(resetQurbaniAddButton);
        }
        wasOpen = open;
      });
      obs.observe(ggCheckout, { attributes: true, attributeFilter: ['class'] });
    })();

    // Add to Cart
    document.querySelectorAll('.add-qurbani-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.country-card');
        const countryName = btn.dataset.countryName;
        const flag = btn.dataset.flag;
        const selectedPill = card.querySelector('.animal-pill.border-\\[\\#01534d\\]');
        if (!selectedPill) return;

        const animalType = selectedPill.dataset.type;
        const animalLabel = selectedPill.dataset.label;
        const unitPrice = parseInt(selectedPill.dataset.price);
        const quantity = parseInt(card.querySelector('.qty-input').value) || 1;
        const behalfOf = card.querySelector('.behalf-input').value;

        const qtyText = quantity > 1 ? ` x${quantity}` : '';
        const itemName = behalfOf
          ? `Qurbani ${countryName} - ${animalLabel}${qtyText} (For: ${behalfOf})`
          : `Qurbani ${countryName} - ${animalLabel}${qtyText}`;

        if (typeof window.addToCart === 'function') {
          window.addToCart({
            id: `qurbani-${btn.dataset.country}-${animalType}-${Date.now()}`,
            name: itemName,
            amount: unitPrice,
            quantity: quantity,
            type: 'single',
            campaign: 'qurbani',
            label: `${flag} ${countryName}`,
            image: btn.dataset.image || '',
            metadata: {
              country: countryName,
              countryCode: btn.dataset.country,
              animalType: animalType,
              animalLabel: animalLabel,
              quantity: quantity,
              behalfOf: behalfOf || null,
              service: 'qurbani'
            }
          });
        }

        // Visual feedback (green "Added!" state)
        const addedText = quantity > 1 ? `${quantity} Added!` : 'Added!';
        btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> ${addedText}`;
        btn.classList.add('bg-green-500');

        // Cancel any prior reset timer for this button
        if (btn._resetTimer) clearTimeout(btn._resetTimer);
        btn._resetTimer = setTimeout(() => {
          resetQurbaniAddButton(btn);
        }, 1500);

        // Reset quantity and behalf input
        card.querySelector('.qty-input').value = '1';
        card.querySelector('.behalf-input').value = '';
        card.querySelector('.behalf-container').classList.add('hidden');
        card.querySelector('.behalf-toggle').classList.remove('hidden');
        updateCardPrice(card);
      });
    });

    // FAQ Accordion
    document.querySelectorAll('.faq-toggle').forEach(button => {
      button.addEventListener('click', () => {
        const content = button.nextElementSibling;
        const icon = button.querySelector('.faq-icon');

        document.querySelectorAll('.faq-content').forEach(c => {
          if (c !== content) {
            c.classList.add('hidden');
            c.previousElementSibling.querySelector('.faq-icon').classList.remove('rotate-180');
          }
        });

        content.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
      });
    });

    // Show More Countries
    const showMoreBtn = document.getElementById('show-more-btn');
    if (showMoreBtn) {
      showMoreBtn.addEventListener('click', () => {
        // Click "All Countries" tab
        const allTab = document.querySelector('[data-category="all"]');
        if (allTab) allTab.click();
        showMoreBtn.closest('#show-more-container').classList.add('hidden');
      });
    }

    // "View All Countries" button (appears when deep-linked via ?country=)
    const viewAllBtn = document.getElementById('view-all-btn');
    if (viewAllBtn) {
      viewAllBtn.addEventListener('click', () => {
        // Show all countries
        const allTab = document.querySelector('[data-category="all"]');
        if (allTab) allTab.click();
        viewAllBtn.closest('#view-all-container').classList.add('hidden');
      });
    }

    // Initially show only first 6 countries in most-needed
    const cards = document.querySelectorAll('.country-card');
    cards.forEach((card, index) => {
      const categories = card.dataset.categories.split(',');
      if (!categories.includes('most-needed')) {
        card.classList.add('hidden');
      }
    });

    // URL parameter deep-linking: ?country=pakistan or ?country=pakistan,india or ?gaza
    (function() {
      const params = new URLSearchParams(window.location.search);
      let countryParam = params.get('country');

      // Support bare parameter like ?gaza (no key=value, just the key)
      if (!countryParam) {
        for (const [key, value] of params.entries()) {
          if (!value || value === '') {
            countryParam = key;
            break;
          }
        }
      }
      if (!countryParam) return;

      // Support comma-separated countries
      const targets = countryParam.toLowerCase().split(',').map(s => s.trim()).filter(Boolean);
      if (targets.length === 0) return;

      // Find all matching cards
      const matchedCards = [];
      document.querySelectorAll('.country-card').forEach(card => {
        const cardId = (card.dataset.country || '').toLowerCase();
        const cardName = (card.dataset.countryName || '').toLowerCase().trim();
        for (const target of targets) {
          if (cardId === target || cardName === target || cardId.includes(target) || cardName.includes(target)) {
            matchedCards.push(card);
            break;
          }
        }
      });

      if (matchedCards.length === 0) return;

      // Hide ALL cards first, then only show matched ones
      document.querySelectorAll('.country-card').forEach(card => {
        card.classList.add('hidden');
      });
      matchedCards.forEach(card => card.classList.remove('hidden'));

      // Update tabs — deactivate all, activate "All Countries"
      document.querySelectorAll('.category-tab').forEach(t => {
        t.classList.remove('active', 'bg-[#01534d]', 'text-white');
        t.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:bg-gray-100');
      });
      const allTab = document.querySelector('[data-category="all"]');
      if (allTab) {
        allTab.classList.add('active', 'bg-[#01534d]', 'text-white');
        allTab.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:bg-gray-100');
      }

      // Hide show-more, show view-all button
      const showMoreContainer = document.getElementById('show-more-container');
      if (showMoreContainer) showMoreContainer.classList.add('hidden');
      const viewAllContainer = document.getElementById('view-all-container');
      if (viewAllContainer) viewAllContainer.classList.remove('hidden');

      // Scroll to the first matched card
      setTimeout(() => {
        matchedCards[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 500);
    })();

    // Tab filter via URL: ?tab=lowest-price or ?lowest or ?emergency
    (function() {
      const params = new URLSearchParams(window.location.search);
      let tabParam = params.get('tab');

      // Support bare params like ?lowest or ?emergency
      if (!tabParam) {
        var tabAliases = {
          'lowest': 'lowest-price',
          'lowest-price': 'lowest-price',
          'cheap': 'lowest-price',
          'cheapest': 'lowest-price',
          'emergency': 'emergency',
          'urgent': 'emergency',
          'all': 'all',
          'most-needed': 'most-needed',
          'popular': 'most-needed'
        };
        for (var entry of params.entries()) {
          if (!entry[1] || entry[1] === '') {
            var mapped = tabAliases[entry[0].toLowerCase()];
            if (mapped) { tabParam = mapped; break; }
          }
        }
      }

      if (!tabParam) return;

      // Click the matching tab
      var targetTab = document.querySelector('[data-category="' + tabParam + '"]');
      if (targetTab) {
        setTimeout(function() { targetTab.click(); }, 300);
      }
    })();
  </script>

  <!-- Inline "Back to Search" button below the grid -->
  <script is:inline>
    (function() {
      var inlineBtn = document.getElementById('back-to-search-inline');
      var searchSection = document.querySelector('#desktop-search-wrap');
      if (!inlineBtn || !searchSection) return;

      inlineBtn.addEventListener('click', function() {
        searchSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(function() {
          var isMobile = window.matchMedia('(max-width: 767px)').matches;
          if (isMobile) {
            var trigger = document.getElementById('mobile-search-trigger');
            if (trigger) trigger.click();
          } else {
            var input = document.getElementById('country-search');
            if (input) input.focus();
          }
        }, 450);
      });
    })();
  </script>

  <!-- Mobile sticky bars: top search appears inside the country grid; bottom CTA elsewhere -->
  <script is:inline>
    (function() {
      var stickyBar = document.getElementById('qurbani-sticky-bar');
      var stickyBtn = document.getElementById('qurbani-sticky-cta') || document.getElementById('qurbani-sticky-btn');
      var topSearch = document.getElementById('qurbani-sticky-search-top');
      var topSearchBtn = document.getElementById('qurbani-sticky-search-btn');
      var donationSection = document.getElementById('select-qurbani');
      var grid = document.getElementById('countries-grid');
      if (!stickyBar || !donationSection) return;

      // Bottom CTA → scroll to country selection section
      if (stickyBtn) {
        stickyBtn.addEventListener('click', function() {
          var rect = donationSection.getBoundingClientRect();
          var scrollTarget = window.pageYOffset + rect.top - 20;
          window.scrollTo({ top: Math.max(0, scrollTarget), behavior: 'smooth' });
        });
      }

      // Top sticky search → open the fullscreen search overlay
      if (topSearchBtn) {
        topSearchBtn.addEventListener('click', function() {
          var trigger = document.getElementById('mobile-search-trigger');
          if (trigger) trigger.click();
        });
      }

      // Show top search when the user is inside the country grid.
      // Hide bottom CTA whenever the "Choose Where to Give" section is in view
      // (entire #select-qurbani section, not just the grid), OR when the hero
      // donation box is visible — in both cases the bottom CTA is redundant.
      var heroDonate = document.getElementById('hero-quick-donate');
      var viewportH = function() { return window.innerHeight || document.documentElement.clientHeight || 0; };
      function update() {
        if (!grid) return;
        var gRect = grid.getBoundingClientRect();
        var insideGrid = gRect.top < 60 && gRect.bottom > 200;

        var sectionVisible = false;
        if (donationSection) {
          var sRect = donationSection.getBoundingClientRect();
          // Visible if any part of the Choose Where to Give section is on screen
          sectionVisible = sRect.bottom > 80 && sRect.top < viewportH();
        }

        var heroVisible = false;
        if (heroDonate) {
          var hRect = heroDonate.getBoundingClientRect();
          heroVisible = hRect.bottom > 0 && hRect.top < viewportH();
        }

        // Top sticky search appears only when actually inside the country grid
        if (insideGrid) {
          if (topSearch) topSearch.classList.remove('-translate-y-full');
        } else {
          if (topSearch) topSearch.classList.add('-translate-y-full');
        }

        // Bottom CTA hidden whenever we're in the donation section or hero box
        if (sectionVisible || heroVisible) {
          stickyBar.classList.add('translate-y-full');
        } else {
          stickyBar.classList.remove('translate-y-full');
        }
      }
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();

      // Hide both bars when the mobile fullscreen search overlay is open
      var searchOverlay = document.getElementById('mobile-search-overlay');
      if (searchOverlay) {
        var sObs = new MutationObserver(function() {
          var open = !searchOverlay.classList.contains('hidden') && searchOverlay.style.display !== 'none';
          if (open) {
            stickyBar.classList.add('translate-y-full');
            if (topSearch) topSearch.classList.add('-translate-y-full');
          } else {
            update();
          }
        });
        sObs.observe(searchOverlay, { attributes: true, attributeFilter: ['class', 'style'] });
      }
    })();
  </script>

  <style>
    .font-arabic {
      font-family: 'Amiri', 'Traditional Arabic', serif;
    }

    /* Hero quick-donate "GIVE QURBANI NOW" button — dark green with proper hover */
    .hqd-submit-btn {
      background: #17401c;
    }
    .hqd-submit-btn:hover {
      background: #0f2d12;
    }
  </style>
</Layout>
