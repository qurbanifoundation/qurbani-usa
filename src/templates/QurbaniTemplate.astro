  },
  {
    question: 'What is the difference between a goat/sheep and cow share Qurbani (Udhiya)?',
    answer: 'A goat or sheep counts as one Qurbani (Udhiya) and is sacrificed for one person. A cow can be divided into 7 shares, so each share counts as one Qurbani. A whole cow equals 7 Qurbanis / Udhiyas.',
  },
  {
    question: 'How is the Qurbani / Udhiya meat distributed?',
    answer: 'We distribute fresh Qurbani (Udhiya) meat to families in need within 24-48 hours of sacrifice. The meat is divided and given to those who rarely have access to protein, bringing joy to their Eid al-Adha celebrations.',
  },
  {
    question: 'Will I receive confirmation of my Qurbani / Udhiya?',
    answer: 'Yes! You will receive an email confirmation with details of your Qurbani (Udhiya), including the country of sacrifice and a certificate of completion after Eid al-Adha.',
  },
  ...(siteConfig.showUS501c3 ? [{
    question: 'Is my Qurbani / Udhiya donation tax-deductible?',
    answer: 'Yes, Qurbani Foundation USA is a registered 501(c)(3) nonprofit organization. All Qurbani and Udhiya donations are tax-deductible to the extent allowed by law.',
  }] : []),
];

// Testimonials
const testimonials = [
  {
    name: 'Ahmed Hassan',
    location: 'New York, USA',
    text: 'I\'ve been giving Qurbani through Qurbani Foundation for 5 years. The process is seamless, and knowing my sacrifice reaches those most in need gives me peace of mind.',
    rating: 5,
  },
  {
    name: 'Fatima Al-Rashid',
    location: 'London, UK',
    text: 'The ability to select specific countries and give on behalf of my late parents is truly special. JazakAllah Khair for making this so easy.',
    rating: 5,
  },
  {
    name: 'Omar Siddiqui',
    location: 'Toronto, Canada',
    text: 'Last year I gave Qurbani to Palestine. Receiving the certificate and knowing families there celebrated Eid with meat was incredibly fulfilling.',
    rating: 5,
  },
];
---

<Layout
  title={heroOverrides?.metaTitle || `Qurbani 2026 — Give Qurbani / Udhiya Online in ${countryCount}+ Countries | Qurbani Foundation`}
  description={heroOverrides?.metaDescription || `Give Qurbani (Udhiya) online for Eid al-Adha 2026. 100% Shariah-compliant Qurbani sacrifice delivered to families in need across ${countryCount}+ countries. Tax-deductible, certificate included, fresh meat distributed within 24 hours. Qurbani from $50.`}
>

  <Navbar />

  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0">
      <img src="/images/qurbani-foundation-qurbani-service.webp" alt="Qurbani Foundation — global Qurbani and Udhiyah service feeding families in need on Eid al-Adha" width="1536" height="1024" fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-[#01534d]/80"></div>
    </div>


    <div class="container mx-auto px-4 pt-28 pb-16 relative z-10">
      <!-- MOBILE-ONLY Arabic Ayat (above donation box) -->
      <div class="text-center max-w-3xl mx-auto mb-6 lg:hidden">
        <p class="text-3xl text-[#D97718] mb-2 font-arabic" style="font-family: 'Amiri', serif;">
          وَالْبُدْنَ جَعَلْنَاهَا لَكُم مِّن شَعَائِرِ اللَّهِ
        </p>
        <p class="text-white/70 text-sm italic">"And the camels and cattle We have made for you as among the symbols of Allah" - Quran 22:36</p>
      </div>

      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center max-w-7xl mx-auto">
        <!-- LEFT (desktop) / SECOND (mobile): Hero copy + CTA -->
        <div class="lg:col-span-7 text-center order-2 lg:order-1">
          <!-- Desktop-only Arabic Ayat (centered within the left column) -->
          <div class="hidden lg:block mb-6">
            <p class="text-3xl md:text-4xl text-[#D97718] mb-3 font-arabic" style="font-family: 'Amiri', serif;">
              وَالْبُدْنَ جَعَلْنَاهَا لَكُم مِّن شَعَائِرِ اللَّهِ
            </p>
            <p class="text-white/70 text-sm italic">"And the camels and cattle We have made for you as among the symbols of Allah" - Quran 22:36</p>
          </div>

          <!-- Main Headline -->
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" style="font-family: 'Signika', sans-serif;">
            {heroOverrides?.headlineLine1 || 'Give Your Qurbani'}<br/>
            <span class="text-[#D97718]">{heroOverrides?.headlineLine2 || "Where It's Needed Most"}</span>
          </h1>

          <!-- Subheadline -->
          <p class="text-xl md:text-2xl text-white/90 mb-10 leading-relaxed">
            {heroOverrides?.subheadline || (
              <>Fulfill your obligation with 100% Shariah-compliant Qurbani.<br class="hidden md:block"/>Fresh meat delivered to families in {countryCount}+ countries within 24 hours.</>
            )}
          </p>

          <!-- Key Points -->
          <div class="flex flex-wrap justify-center gap-3 mb-10">
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full">
              <svg class="w-5 h-5 text-white/80" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-white text-sm">Shariah Compliant</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full">
              <svg class="w-5 h-5 text-white/80" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-white text-sm">{countryCount}+ Countries</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full">
              <svg class="w-5 h-5 text-white/80" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-white text-sm">From $50</span>
            </div>
            <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full">
              <svg class="w-5 h-5 text-white/80" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-white text-sm">Tax Deductible</span>
            </div>
          </div>

          <!-- CTA Button: orange, points down to country grid -->
          <a href="#select-qurbani" class="inline-flex items-center gap-3 bg-[#D97718] hover:bg-[#c56a15] text-white font-bold py-4 px-10 rounded-full text-lg transition-all transform hover:scale-105 shadow-xl">
            <span>{heroOverrides?.ctaText || 'Browse Qurbani Countries'}</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
          </a>

          <!-- Trust Badge -->
          <div class="mt-6 inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm px-5 py-2.5 rounded-full border border-white/20">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            <span class="text-white/90 text-sm font-medium">{heroOverrides?.trustBadgeText || '2 Million+ People Fed Globally'}</span>
          </div>
        </div>

        <!-- RIGHT (desktop) / FIRST (mobile): Quick Donation Box -->
        <div class="lg:col-span-5 order-1 lg:order-2">
          <div id="hero-quick-donate" class="rounded-2xl overflow-hidden mx-auto max-w-md lg:max-w-none" style="box-shadow: 0 24px 80px rgba(0,0,0,0.35);" data-quick-donate data-fund-type="qurbani" data-campaign-slug="qurbani" data-item-name="Qurbani">
            <!-- Header -->
            <div class="px-6 pt-6 pb-5 text-center text-white relative overflow-hidden" style="background: linear-gradient(160deg, #17401c 0%, #0f2d12 100%);">
              <div class="absolute -top-6 -right-6 w-24 h-24 rounded-full opacity-10 bg-white"></div>
              <h2 class="text-2xl font-extrabold tracking-tight" style="font-family: 'Signika', sans-serif;">Fulfill Your Qurbani</h2>
              <p class="text-[13px] text-white/80 mt-1">Fresh meat distributed to families in need</p>
            </div>
            <!-- Body -->
            <div class="bg-white px-5 py-5">
              <!-- Two preset buttons (Where Most Needed = default; Most Impact = Palestine Gaza price) -->
              {(() => {
                const palestine = countries.find((c: any) => c.id === 'palestine-gaza');
                const palestineAnimals = (palestine?.animals || []).filter((a: any) => a.active !== false);
                const palestineHeadline = palestineAnimals.find((a: any) => a.type === 'cow_share')
                  || palestineAnimals.find((a: any) => a.type === 'sheep_goat' || a.type === 'sheep' || a.type === 'goat')
                  || palestineAnimals[0];
                const impactPrice = palestineHeadline?.price || 400;
                return (
                  <div class="grid grid-cols-2 gap-3 mb-4">
                    <button type="button" class="hqd-quick border-2 border-[#17401c] bg-[#17401c]/5 rounded-xl py-4 text-center cursor-pointer transition-all" data-quick-price="100" data-quick-name="Where Most Needed" data-quick-id="where-most-needed">
                      <div class="text-[11px] sm:text-[12px] font-bold text-gray-600 uppercase whitespace-nowrap">Where Most Needed</div>
                      <div class="text-2xl font-extrabold text-[#17401c] mt-1" style="font-family: 'Signika', sans-serif;">$100</div>
                    </button>
                    <button type="button" class="hqd-quick border-2 border-gray-200 rounded-xl pt-5 pb-4 text-center cursor-pointer transition-all hover:border-[#17401c] relative" data-quick-price={impactPrice} data-quick-name="Palestine Gaza" data-quick-id="palestine-gaza" data-quick-flag={palestine?.flag || '🇵🇸'} data-quick-image={palestine?.image || ''}>
                      <span class="absolute -top-3 left-1/2 -translate-x-1/2 text-[9px] font-extrabold px-2 py-0.5 rounded-full bg-[#D97718] text-white uppercase tracking-wider shadow whitespace-nowrap">Most Impact</span>
                      <div class="text-[11px] sm:text-[12px] font-bold text-gray-600 uppercase whitespace-nowrap">🇵🇸 Palestine Gaza</div>
                      <div class="text-2xl font-extrabold text-[#17401c] mt-1" style="font-family: 'Signika', sans-serif;">${impactPrice}</div>
                    </button>
                  </div>
                );
              })()}
              <!-- Divider -->
              <div class="flex items-center gap-3 mb-3">
                <div class="flex-1 h-px bg-gray-200"></div>
                <span class="text-[11px] font-bold text-gray-400 uppercase">or choose a country</span>
                <div class="flex-1 h-px bg-gray-200"></div>
              </div>

              <!-- Searchable country combobox -->
              <div class="mb-4 relative" id="hqd-country-wrap">
                <div class="relative">
                  <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                  <input
                    type="text"
                    id="hqd-country-input"
                    placeholder="Select a country"
                    autocomplete="off"
                    class="w-full pl-10 pr-10 py-3.5 border-2 border-gray-200 rounded-xl text-base bg-white font-semibold text-gray-800 placeholder-gray-500 hover:border-[#17401c] focus:border-[#17401c] focus:outline-none focus:ring-2 focus:ring-[#17401c]/20 cursor-pointer"
                  />
                  <button type="button" id="hqd-country-clear" aria-label="Clear" class="hidden absolute right-3 top-1/2 -translate-y-1/2 w-7 h-7 flex items-center justify-center rounded-full bg-gray-200 hover:bg-gray-300 text-gray-600 transition">
                    <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                  </button>
                </div>
                <div id="hqd-country-list" class="hidden absolute left-0 right-0 top-[calc(100%+6px)] z-30 bg-white rounded-xl shadow-2xl border border-gray-100 max-h-[320px] overflow-y-auto">
                  {(() => {
                    // Build a normalized country list with headline (Cow Share or fallback)
                    const enriched = countries.map((c: any) => {
                      const animals = (c.animals || []).filter((a: any) => a.active !== false);
                      const headline = animals.find((a: any) => a.type === 'cow_share')
                        || animals.find((a: any) => a.type === 'sheep_goat' || a.type === 'sheep' || a.type === 'goat')
                        || animals[0];
                      return headline ? { c, price: headline.price } : null;
                    }).filter(Boolean) as { c: any; price: number }[];

                    // Most Popular = admin-flagged (show all of them).
                    // Sort: popularOrder field if set (lower = higher position), then by price desc.
                    // Fallback to top 6 by price if admin hasn't flagged any.
                    const flagged = enriched.filter(({ c }) => (c as any).popular === true);
                    const sortByPriceDesc = (a: any, b: any) => (b.price || 0) - (a.price || 0);
                    const sortByPopularOrder = (a: any, b: any) => {
                      const ao = (a.c as any).popularOrder;
                      const bo = (b.c as any).popularOrder;
                      if (ao != null && bo != null) return ao - bo;
                      if (ao != null) return -1;
                      if (bo != null) return 1;
                      return sortByPriceDesc(a, b);
                    };
                    const popular = flagged.length > 0
                      ? flagged.slice().sort(sortByPopularOrder)
                      : enriched.slice().sort(sortByPriceDesc).slice(0, 6);
                    const sorted = enriched.slice().sort((a, b) => a.c.name.localeCompare(b.c.name));

                    const renderRow = (c: any, price: number, isPopular: boolean) => (
                      <button type="button" class="hqd-country-opt w-full flex items-center justify-between px-4 py-3 hover:bg-gray-50 active:bg-gray-100 transition cursor-pointer text-left border-b border-gray-50 last:border-b-0" data-id={c.id} data-name={c.name} data-flag={c.flag} data-image={c.image} data-price={price}>
                        <span class="flex items-center gap-2 min-w-0">
                          {c.flag && <span class="text-lg flex-shrink-0">{c.flag}</span>}
                          <span class="font-semibold text-gray-800 truncate">{c.name}</span>
                          {isPopular && <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-[#D97718]/10 text-[#D97718] flex-shrink-0">POPULAR</span>}
                        </span>
                        <span class="text-sm font-bold text-[#17401c] flex-shrink-0">From ${price}</span>
                      </button>
                    );

                    return (
                      <>
                        {popular.length > 0 && (
                          <>
                            <div class="px-4 pt-3 pb-2 flex items-center gap-2">
                              <span class="text-[11px] font-bold tracking-wider text-[#D97718] uppercase">★ Most Popular</span>
                              <span class="text-[10px] text-gray-400">— Donor favorites</span>
                            </div>
                            <div class="bg-gradient-to-b from-[#D97718]/5 to-transparent">
                              {popular.map(({ c, price }) => renderRow(c, price, true))}
                            </div>
                            <div class="border-t border-gray-100 my-1"></div>
                          </>
                        )}
                        <div class="px-4 pt-2 pb-2 text-[11px] font-bold tracking-wider text-gray-400 uppercase">All Countries</div>
                        {sorted.map(({ c, price }) => renderRow(c, price, false))}
                      </>
                    );
                  })()}
                </div>
              </div>

              <!-- Quantity:
                   Mobile: label on its own line; presets left | divider center | +/- right.
                   Desktop: everything on one line — Quantity label · presets · divider · +/-. -->
              <div class="mb-4">
                <div class="flex flex-col md:flex-row md:items-center md:gap-3">
                  <label for="hqd-qty" class="text-sm font-semibold text-gray-700 mb-2 md:mb-0 md:flex-shrink-0">Quantity</label>
                  <div class="flex items-center gap-1.5 justify-between md:gap-3 flex-1">
                    <!-- Preset chips -->
                    <div class="flex items-center gap-1.5">
                      <button type="button" class="hqd-qty-preset h-9 min-w-[36px] px-2 text-xs font-bold text-gray-600 border border-gray-200 rounded-lg hover:border-[#17401c] hover:text-[#17401c] active:scale-95 cursor-pointer transition" data-qty="1">1</button>
                      <button type="button" class="hqd-qty-preset h-9 min-w-[36px] px-2 text-xs font-bold text-gray-600 border border-gray-200 rounded-lg hover:border-[#17401c] hover:text-[#17401c] active:scale-95 cursor-pointer transition" data-qty="3">3</button>
                      <button type="button" class="hqd-qty-preset h-9 min-w-[36px] px-2 text-xs font-bold text-gray-600 border border-gray-200 rounded-lg hover:border-[#17401c] hover:text-[#17401c] active:scale-95 cursor-pointer transition" data-qty="5">5</button>
                      <button type="button" class="hqd-qty-preset h-9 min-w-[36px] px-2 text-xs font-bold text-gray-600 border border-gray-200 rounded-lg hover:border-[#17401c] hover:text-[#17401c] active:scale-95 cursor-pointer transition" data-qty="10">10</button>
                    </div>
                    <!-- Divider -->
                    <span class="w-px h-7 bg-gray-200 flex-shrink-0"></span>
                    <!-- − / input / + -->
                    <div class="flex items-center gap-1.5">
                      <button type="button" id="hqd-minus" aria-label="Decrease quantity" class="w-9 h-9 border-2 border-gray-200 rounded-full flex items-center justify-center text-xl font-bold text-gray-700 hover:border-[#17401c] hover:bg-[#17401c]/5 active:scale-95 cursor-pointer transition">−</button>
                      <input
                        type="number"
                        id="hqd-qty"
                        min="1"
                        max="999"
                        value="1"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        aria-label="Quantity"
                        class="w-12 h-9 text-center text-base font-bold text-gray-900 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-[#17401c] focus:ring-2 focus:ring-[#17401c]/20"
                        style="font-family: 'Signika', sans-serif;"
                      />
                      <button type="button" id="hqd-plus" aria-label="Increase quantity" class="w-9 h-9 border-2 border-gray-200 rounded-full flex items-center justify-center text-xl font-bold text-gray-700 hover:border-[#17401c] hover:bg-[#17401c]/5 active:scale-95 cursor-pointer transition">+</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Total (bigger emphasis) -->
              <div class="bg-gradient-to-r from-[#17401c]/5 to-[#17401c]/0 border-2 border-[#17401c]/10 rounded-xl px-4 py-3.5 mb-4 flex items-center justify-between">
                <span class="text-sm font-medium text-gray-600">Total:</span>
                <span id="hqd-total" class="text-3xl font-extrabold text-[#17401c]" style="font-family: 'Signika', sans-serif;">$100</span>
