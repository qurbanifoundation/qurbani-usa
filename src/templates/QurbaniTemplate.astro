    ],
    description: 'Mountain community support',
    lowestPrice: true
  },
].sort((a, b) => a.name.localeCompare(b.name));

// Merge saved pricing overrides from template_config (admin-editable)
const savedPricing = (campaign.template_config?.qurbaniPricing || {}) as Record<string, Record<string, number>>;
countries.forEach(country => {
  const overrides = savedPricing[country.id];
  if (overrides) {
    country.animals.forEach(animal => {
      if (overrides[animal.type] !== undefined && overrides[animal.type] > 0) {
        animal.price = overrides[animal.type];
      }
    });
  }
});

// Filter animals by active status (from admin toggle)
countries.forEach(country => {
  if (country.animals) {
    country.animals = country.animals.filter((a: any) => a.active !== false);
  }
});

// (Image URL normalization removed — it was causing slow first-paint on iOS
// Safari because the normalized webp URLs trigger fresh Unsplash CDN encodes.
// Falls back to the URLs as stored in the DB / Unsplash defaults.)

// Statistics
const countryCount = countries.length;
const stats = [
  { number: '2M+', label: 'People Fed Last Year' },
  { number: `${countryCount}+`, label: 'Countries Served' },
  { number: '100%', label: 'Shariah Compliant' },
  { number: '27+', label: 'Years of Service' },
];

// FAQ items
const faqs = [
  {
    question: 'What is Qurbani / Udhiya?',
    answer: 'Qurbani (also known as Udhiya or Udhiyah) is the sacred sacrifice of an animal during Eid al-Adha to commemorate Prophet Ibrahim\'s (AS) willingness to sacrifice his son for Allah. The terms Qurbani and Udhiya refer to the same act of worship — Qurbani is more commonly used in South Asia while Udhiya is the Arabic term. It is obligatory (Wajib) for every Muslim who meets the Nisab threshold.',
  },
  {
    question: 'Is Qurbani the same as Udhiya?',
    answer: 'Yes — Qurbani and Udhiya (also spelled Udhiyah) are the same ritual sacrifice performed during Eid al-Adha. "Udhiya" comes from the Arabic word meaning "sacrifice at the time of forenoon," while "Qurbani" comes from the word "Qurban" meaning "nearness to Allah." Both refer to the obligatory sacrifice of a sheep, goat, cow, or camel on the days of Eid al-Adha.',
  },
  {
    question: 'When is Qurbani / Udhiya performed?',
    answer: 'Qurbani (Udhiya) must be performed during the days of Eid al-Adha: from after the Eid prayer on the 10th of Dhul Hijjah until before sunset on the 13th of Dhul Hijjah. These are known as the Days of Tashreeq.',
