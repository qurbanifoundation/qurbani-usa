              <!-- Submit (large, accessible) -->
              <button type="button" id="hqd-submit" class="hqd-submit-btn w-full text-white font-extrabold py-4 rounded-xl transition-all text-base tracking-wide cursor-pointer border-none shadow-lg hover:shadow-xl active:scale-[0.98] flex items-center justify-center gap-2" style="font-family:Signika,sans-serif">
                <span class="pointer-events-none">ADD TO DONATION</span>
                <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              </button>

              <!-- Trust badges (real country count) -->
