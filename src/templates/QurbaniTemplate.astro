  <!-- Reusable bullet-proof tap handler — detects real taps (not scrolls) on iOS/Android,
       falls back to click for desktop / older browsers. Prevents double-fire. -->
  <script is:inline>
    window.bindTapHandler = window.bindTapHandler || function(el, handler) {
      if (!el) return;
      var startX = 0, startY = 0, startT = 0, moved = false;
      var locked = false;
      function fire(e) {
        if (locked) return;
        locked = true;
        setTimeout(function() { locked = false; }, 500);
        if (e && typeof e.preventDefault === 'function') e.preventDefault();
        if (e && typeof e.stopPropagation === 'function') e.stopPropagation();
        handler(e);
      }
      el.addEventListener('touchstart', function(e) {
        var t = e.touches && e.touches[0];
        if (!t) return;
        startX = t.clientX; startY = t.clientY; startT = Date.now(); moved = false;
      }, { passive: true });
      el.addEventListener('touchmove', function(e) {
        var t = e.touches && e.touches[0];
        if (!t) return;
        // 10px deadzone — anything more is a scroll, cancel the tap
        if (Math.abs(t.clientX - startX) > 10 || Math.abs(t.clientY - startY) > 10) moved = true;
      }, { passive: true });
      el.addEventListener('touchend', function(e) {
        if (moved) return;
        if (Date.now() - startT > 500) return; // too slow → not a tap
        fire(e);
      }, { passive: false });
      // Desktop / fallback for browsers that didn't fire touchend (e.g., synthetic clicks)
      el.addEventListener('click', fire);
    };
  </script>

  <!-- Hero Quick-Donate logic -->
  <script is:inline>
    (function() {
      var card = document.getElementById('hero-quick-donate');
      if (!card) return;

      var quickBtns = card.querySelectorAll('.hqd-quick');
      var qtyEl = document.getElementById('hqd-qty');
      var totalEl = document.getElementById('hqd-total');
      var submitBtn = document.getElementById('hqd-submit');

      // Custom country combobox elements
      var countryWrap = document.getElementById('hqd-country-wrap');
      var countryInput = document.getElementById('hqd-country-input');
      var countryClear = document.getElementById('hqd-country-clear');
      var countryList = document.getElementById('hqd-country-list');

      var qty = 1;
      var selectedPrice = 100;
      var selectedName = 'Where Most Needed';
      var selectedId = 'where-most-needed';
      var selectedFlag = '';
      var selectedImage = '';
      var hasCountrySelected = false;

      function updateTotal() {
        var t = selectedPrice * qty;
        if (totalEl) totalEl.textContent = '$' + t.toLocaleString();
      }

      function deselectQuickBtns() {
        quickBtns.forEach(function(b) {
          b.classList.remove('border-[#17401c]', 'bg-[#17401c]/5');
          b.classList.add('border-gray-200');
        });
      }

      function resetCountryInput() {
        if (countryInput) countryInput.value = '';
        if (countryClear) countryClear.classList.add('hidden');
        hasCountrySelected = false;
        // Show all options (un-filter)
        filterCountryList('');
      }

      // Quick presets
      quickBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          selectedPrice = parseInt(btn.dataset.quickPrice || '75');
          selectedName = btn.dataset.quickName || 'Where Most Needed';
          selectedId = btn.dataset.quickId || 'where-most-needed';
          selectedFlag = btn.dataset.quickFlag || '';
          selectedImage = btn.dataset.quickImage || '';
          resetCountryInput();
          deselectQuickBtns();
          btn.classList.add('border-[#17401c]', 'bg-[#17401c]/5');
          btn.classList.remove('border-gray-200');
          updateTotal();
        });
      });

      // Open / close
      function closeCountryList() {
        if (countryList) countryList.classList.add('hidden');
      }
      function openCountryList() {
        if (countryList) countryList.classList.remove('hidden');
      }

      // Filter rows by query; hides section headers when their section has no matches.
      function filterCountryList(query) {
        if (!countryList) return;
        var q = (query || '').trim().toLowerCase();
        var opts = countryList.querySelectorAll('.hqd-country-opt');
        opts.forEach(function(opt) {
          var name = (opt.dataset.name || '').toLowerCase();
          var match = !q || name.indexOf(q) !== -1;
          opt.style.display = match ? '' : 'none';
        });
        // Hide section headers when all rows below them are hidden, until next header or end.
        var children = Array.from(countryList.children);
        children.forEach(function(node, i) {
          var isHeader = node.classList && (
            node.classList.contains('hqd-section-header') ||
            (node.querySelector && node.querySelector('.hqd-section-marker'))
          );
        });
      }

      // On mobile, route the hero country input to the existing fullscreen search overlay
      // (keyboard-aware) so the keyboard doesn't crush the dropdown.
      var isMobileMatch = window.matchMedia('(max-width: 767px)').matches;
      function applyCountryToHero(country) {
        if (!country) return;
        var price = parseInt(country.price || '0');
        if (price <= 0) return;
        selectedPrice = price;
        selectedName = country.name || '';
        selectedId = country.id || '';
        selectedFlag = country.flag || '';
        selectedImage = country.image || '';
        hasCountrySelected = true;
        if (countryInput) {
          countryInput.value = (selectedFlag ? selectedFlag + ' ' : '') + selectedName + ' — $' + price;
        }
        if (countryClear) countryClear.classList.remove('hidden');
        deselectQuickBtns();
        closeCountryList();
        updateTotal();
      }
      // Expose for the mobile fullscreen overlay handler
      window.__heroQuickDonateApply = applyCountryToHero;

      if (countryInput) {
        // Mobile: detect a real TAP (touchstart + touchend close in time/space, no scroll).
        // We must not open on touchstart alone or on accidental thumb rest while scrolling.
        var touchStartY = 0, touchStartX = 0, touchStartT = 0, touchMoved = false;
        countryInput.addEventListener('touchstart', function(e) {
          if (!window.matchMedia('(max-width: 767px)').matches) return;
          var t = e.touches && e.touches[0];
          if (!t) return;
          touchStartX = t.clientX;
          touchStartY = t.clientY;
          touchStartT = Date.now();
          touchMoved = false;
        }, { passive: true });
        countryInput.addEventListener('touchmove', function(e) {
          if (!window.matchMedia('(max-width: 767px)').matches) return;
          var t = e.touches && e.touches[0];
          if (!t) return;
          // If the finger moved more than 8px in any direction, treat as scroll, not tap
          if (Math.abs(t.clientX - touchStartX) > 8 || Math.abs(t.clientY - touchStartY) > 8) {
            touchMoved = true;
          }
        }, { passive: true });
        countryInput.addEventListener('touchend', function(e) {
          if (!window.matchMedia('(max-width: 767px)').matches) return;
          var dt = Date.now() - touchStartT;
          // Only open if it was a quick (<500ms) stationary tap
          if (touchMoved || dt > 500) return;
          e.preventDefault();
          countryInput.blur();
          window.__heroOriginatedSearch = true;
          var trigger = document.getElementById('mobile-search-trigger');
          if (trigger) trigger.click();
        }, { passive: false });

        // Block focus/keyboard if a tap somehow gets through to the input on mobile
        countryInput.addEventListener('mousedown', function(e) {
          if (window.matchMedia('(max-width: 767px)').matches) {
            e.preventDefault();
            countryInput.blur();
          }
        });

        // Desktop only: open dropdown on focus / click
        countryInput.addEventListener('focus', function() {
          if (window.matchMedia('(max-width: 767px)').matches) return;
          if (hasCountrySelected) {
            countryInput.value = '';
            hasCountrySelected = false;
            if (countryClear) countryClear.classList.add('hidden');
            filterCountryList('');
          }
          openCountryList();
        });
        countryInput.addEventListener('click', function() {
          if (window.matchMedia('(max-width: 767px)').matches) return;
          openCountryList();
        });

        // Filter as user types
        countryInput.addEventListener('input', function() {
          var v = countryInput.value;
          if (countryClear) {
            if (v.length > 0) countryClear.classList.remove('hidden');
            else countryClear.classList.add('hidden');
          }
          openCountryList();
          filterCountryList(v);
        });

        // Pressing Enter selects the first visible option
        countryInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            var firstVisible = Array.from(countryList.querySelectorAll('.hqd-country-opt'))
              .find(function(o) { return o.style.display !== 'none'; });
            if (firstVisible) firstVisible.click();
          } else if (e.key === 'Escape') {
            countryInput.blur();
            closeCountryList();
          }
        });
      }

      if (countryClear) {
        countryClear.addEventListener('click', function(e) {
          e.stopPropagation();
          resetCountryInput();
          if (countryInput) countryInput.focus();
        });
      }

      // Click outside closes
      document.addEventListener('click', function(e) {
        if (countryWrap && !countryWrap.contains(e.target)) closeCountryList();
      });
      document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeCountryList(); });

      // Country option selection
      if (countryList) {
        countryList.querySelectorAll('.hqd-country-opt').forEach(function(opt) {
          opt.addEventListener('click', function() {
            var price = parseInt(opt.dataset.price || '0');
            if (price <= 0) return;
            selectedPrice = price;
            selectedName = opt.dataset.name || '';
            selectedId = opt.dataset.id || '';
            selectedFlag = opt.dataset.flag || '';
            selectedImage = opt.dataset.image || '';
            hasCountrySelected = true;
            if (countryInput) {
              countryInput.value = (selectedFlag ? selectedFlag + ' ' : '') + selectedName + ' — $' + price;
              countryInput.blur();
            }
            if (countryClear) countryClear.classList.remove('hidden');
            deselectQuickBtns();
            closeCountryList();
            updateTotal();
          });
        });
      }

      // Qty handling — input field, +/- buttons, and preset chips
      var minus = document.getElementById('hqd-minus');
      var plus = document.getElementById('hqd-plus');
      var presets = card.querySelectorAll('.hqd-qty-preset');

      function setQty(n, fromInput) {
        n = parseInt(n);
        if (isNaN(n) || n < 1) n = 1;
        if (n > 999) n = 999;
        qty = n;
        if (qtyEl && !fromInput) qtyEl.value = n;
        updatePresetHighlight();
        updateTotal();
      }

      function updatePresetHighlight() {
        presets.forEach(function(btn) {
          if (parseInt(btn.dataset.qty) === qty) {
            btn.classList.add('border-[#17401c]', 'bg-[#17401c]/5', 'text-[#17401c]');
            btn.classList.remove('border-gray-200', 'text-gray-600');
          } else {
            btn.classList.remove('border-[#17401c]', 'bg-[#17401c]/5', 'text-[#17401c]');
            btn.classList.add('border-gray-200', 'text-gray-600');
          }
        });
      }

      if (qtyEl) {
        // Manual entry — accept any number on blur or Enter
        qtyEl.addEventListener('input', function() { setQty(qtyEl.value, true); });
        qtyEl.addEventListener('blur', function() {
          if (!qtyEl.value || parseInt(qtyEl.value) < 1) qtyEl.value = '1';
          setQty(qtyEl.value, true);
        });
        // Select all on focus so older users can easily replace the value
        qtyEl.addEventListener('focus', function() { qtyEl.select(); });
      }
      if (minus) minus.addEventListener('click', function() { setQty(qty - 1); });
      if (plus) plus.addEventListener('click', function() { setQty(qty + 1); });
      presets.forEach(function(btn) {
        btn.addEventListener('click', function() { setQty(btn.dataset.qty); });
      });
      updatePresetHighlight(); // initial state

      // Submit -> add to cart, open checkout. Uses real tap detection
      // (touchstart/move/end + click fallback) so scrolling never triggers it.
      if (submitBtn) {
        bindTapHandler(submitBtn, function() {
          if (typeof window.addToCart !== 'function') return;
          var qtyText = qty > 1 ? ' x' + qty : '';
          var nameLabel = selectedFlag ? (selectedFlag + ' ' + selectedName) : selectedName;
          window.addToCart({
            id: 'qurbani-hero-' + selectedId + '-' + qty + '-' + Date.now(),
            name: 'Qurbani ' + selectedName + qtyText,
            amount: selectedPrice,
            quantity: qty,
            type: 'single',
            campaign: 'qurbani',
            label: nameLabel,
            image: selectedImage,
            metadata: {
              country: selectedName,
              countryCode: selectedId,
              service: 'qurbani',
              sourceLocation: 'hero-quick-donate'
            }
          });
        });
      }
    })();
  </script>

