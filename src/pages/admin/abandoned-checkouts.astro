              </thead>
              <tbody class="divide-y divide-gray-100">
                {relatedDonations.map((d: any) => (
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-2 text-gray-700 whitespace-nowrap">{formatDate(d.created_at)}</td>
                    <td class="px-4 py-2 text-gray-700">{d.campaign_name || d.campaign_slug || '-'}</td>
                    <td class="px-4 py-2 text-right font-semibold text-gray-800">{formatAmount(d.amount)}</td>
                    <td class="px-4 py-2 text-center capitalize text-gray-600">{d.donation_type || '-'}</td>
                    <td class="px-4 py-2 text-center">
                      <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-semibold capitalize ${
                        d.status === 'completed' ? 'bg-green-100 text-green-800'
                        : d.status === 'failed' ? 'bg-red-100 text-red-800'
                        : d.status === 'pending' ? 'bg-yellow-100 text-yellow-800'
                        : 'bg-gray-100 text-gray-700'}`}>{d.status}</span>
                    </td>
                    <td class="px-4 py-2 text-right">
                      <a href={`/admin/donations?donation=${d.id}`} class="text-xs text-blue-600 hover:underline">View &rarr;</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>

    <script
      is:inline
      define:vars={{
        checkoutId: detail.id,
        donorEmail: detail.email,
        donorPhone: detail.phone || derivedPhone || '',
        donorName: fullName,
        donorFirstName: detail.first_name || '',
        donorLastName: detail.last_name || '',
        currentCampaignSlug: detail.campaign_slug,
        donorAddress: derivedAddress || null,
        attemptedItems: (lastAttemptedItems && lastAttemptedItems.length > 0)
          ? lastAttemptedItems
          : (abandonedCartItems || []),
        attemptedAmount: detail.amount || (lastAttemptedDonation?.amount || 0),
        defaultCampaignName: detail.campaign_slug
          ? detail.campaign_slug.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())
          : 'General Donation',
        campaignUrlMap,
      }}
    >
      // Copy resume link
      const copyResumeBtn = document.getElementById('copy-resume-btn');
      if (copyResumeBtn) {
        copyResumeBtn.addEventListener('click', async () => {
          const url = copyResumeBtn.dataset.url;
          if (!url) return;
          try {
            await navigator.clipboard.writeText(url);
            copyResumeBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Copied!';
            setTimeout(() => {
              copyResumeBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> Copy Resume Link';
            }, 2000);
          } catch {
            prompt('Copy this URL:', url);
          }
        });
      }

      // Generate charge link
      const generateBtn = document.getElementById('generate-link-btn');
      const amountInput = document.getElementById('charge-amount');
      const campaignSelect = document.getElementById('charge-campaign');
      const linkResult = document.getElementById('link-result');
      const linkError = document.getElementById('link-error');
      const generatedUrl = document.getElementById('generated-url');
      const copyGeneratedBtn = document.getElementById('copy-generated-link');
      const openGeneratedLink = document.getElementById('open-generated-link');
      const smsLink = document.getElementById('sms-link');

      if (generateBtn) {
        generateBtn.addEventListener('click', async () => {
          linkError.classList.add('hidden');
          linkResult.classList.add('hidden');

          const amount = parseFloat(amountInput.value);
          if (!amount || amount < 1) {
            linkError.textContent = 'Please enter a valid amount of $1 or more.';
            linkError.classList.remove('hidden');
            return;
          }

          generateBtn.disabled = true;
          const originalHtml = generateBtn.innerHTML;
          generateBtn.innerHTML = 'Generating...';

          try {
            const campaignSlug = campaignSelect.value;
            const selectedOption = campaignSelect.options[campaignSelect.selectedIndex];
            const campaignName = selectedOption ? selectedOption.text.replace(/\s*\(current\)\s*$/, '') : '';

            const res = await fetch('/api/admin/abandoned-checkouts-charge-link', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                abandoned_checkout_id: checkoutId,
                amount,
                campaign_slug: campaignSlug,
                campaign_name: campaignName,
              }),
            });
            const data = await res.json();

            if (!res.ok || !data.success) {
              throw new Error(data.error || 'Failed to create link');
            }

            generatedUrl.value = data.url;
            openGeneratedLink.href = data.url;
            linkResult.classList.remove('hidden');

            if (smsLink && donorPhone) {
              const cleanedPhone = donorPhone.replace(/[^0-9+]/g, '');
              const msg = `Hi${donorName ? ' ' + donorName.split(' ')[0] : ''}, here's your secure payment link to complete your donation: ${data.url} - Qurbani Foundation`;
              smsLink.href = `sms:${cleanedPhone}?body=${encodeURIComponent(msg)}`;
            }
          } catch (err) {
            linkError.textContent = err.message || 'Failed to generate link. Please try again.';
            linkError.classList.remove('hidden');
          } finally {
            generateBtn.disabled = false;
            generateBtn.innerHTML = originalHtml;
          }
        });
      }

      if (copyGeneratedBtn) {
        copyGeneratedBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(generatedUrl.value);
            const original = copyGeneratedBtn.textContent;
            copyGeneratedBtn.textContent = 'Copied!';
            setTimeout(() => { copyGeneratedBtn.textContent = original; }, 2000);
          } catch {
            generatedUrl.select();
            document.execCommand('copy');
          }
        });
      }

      // Open Pre-filled Site Checkout
      const openSiteBtn = document.getElementById('open-site-checkout-btn');
      if (openSiteBtn) {
        openSiteBtn.addEventListener('click', () => {
          const amount = parseFloat(amountInput.value) || attemptedAmount || 0;
          if (!amount || amount < 1) {
            linkError.textContent = 'Please enter a valid amount of $1 or more.';
            linkError.classList.remove('hidden');
            return;
          }

          const campaignSlug = campaignSelect.value || currentCampaignSlug || 'general';
          const selectedOption = campaignSelect.options[campaignSelect.selectedIndex];
          const campaignName = selectedOption ? selectedOption.text.replace(/\s*\(current\)\s*$/, '') : defaultCampaignName;

          // Build cart items — reuse the donor's last attempted items if the
          // amount/campaign match; otherwise build a single-item cart at the
          // (possibly edited) amount.
          let cartItems;
          const itemsTotal = (attemptedItems || []).reduce(
            (sum, i) => sum + ((parseFloat(i.amount) || 0) * (i.quantity || 1)), 0
          );
          const sameCampaign = (attemptedItems || []).every(
            (i) => !i.campaign || i.campaign === campaignSlug
          );
          if (attemptedItems && attemptedItems.length > 0 && Math.abs(itemsTotal - amount) < 0.01 && sameCampaign) {
            cartItems = attemptedItems.map((i) => ({
              id: i.id || (campaignSlug + '-' + Date.now()),
              name: i.name || i.label || campaignName,
              campaign: i.campaign || campaignSlug,
              amount: parseFloat(i.amount) || 0,
              quantity: i.quantity || 1,
              type: i.type || 'single',
              label: i.label || i.name || campaignName,
              metadata: i.metadata || {},
            }));
          } else {
            cartItems = [{
              id: campaignSlug + '-admin-' + Date.now(),
              name: campaignName,
              campaign: campaignSlug,
              amount,
              quantity: 1,
              type: 'single',
              label: campaignName,
              metadata: {},
            }];
          }

          const prefillPayload = {
            items: cartItems,
            donor: {
              firstName: donorFirstName,
              lastName: donorLastName,
              email: donorEmail,
              phone: donorPhone,
              address: donorAddress || null,
            },
            source: 'admin-charge',
            abandoned_checkout_id: checkoutId,
            generated_at: Date.now(),
          };

          try {
            // Stash prefill payload + cart on this origin so the donate page
            // can read it (same-origin localStorage works across tabs).
            localStorage.setItem('qurbani_admin_prefill', JSON.stringify(prefillPayload));
            localStorage.setItem('donationCart', JSON.stringify(cartItems));
          } catch (e) {
            linkError.textContent = 'Could not stash prefill data. Try again.';
            linkError.classList.remove('hidden');
            return;
          }

          // Open the campaign page in a new tab — use the actual url_path from
          // the campaigns table (campaigns are at /<slug> or /<category>/<slug>,
          // NOT /appeals/<slug>). Fall back to /donate if no mapping exists.
          let targetPath = campaignUrlMap?.[campaignSlug] || null;
          if (!targetPath || campaignSlug === 'general') targetPath = '/donate';
          const targetUrl = `${targetPath}${targetPath.includes('?') ? '&' : '?'}admin_prefill=1`;
          window.open(targetUrl, '_blank', 'noopener');
        });
      }
    </script>
  ) : (
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- LIST VIEW                                              -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div>
      <!-- Stats Cards -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-sm p-5 border border-teal-100">
          <p class="text-sm text-teal-600 font-medium">Completed</p>
          <p class="text-2xl font-bold text-teal-700 mt-1">{stats.completed}</p>
          <p class="text-xs text-gray-400 mt-1">{formatAmount(stats.revenueCompleted)} normal</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-5 border border-amber-100">
          <p class="text-sm text-amber-600 font-medium">Abandoned</p>
          <p class="text-2xl font-bold text-amber-700 mt-1">{stats.abandoned}</p>
          <p class="text-xs text-gray-400 mt-1">{formatAmount(stats.revenueAbandoned)} at risk</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-5 border border-green-100">
          <p class="text-sm text-green-600 font-medium">Recovered</p>
          <p class="text-2xl font-bold text-green-700 mt-1">{stats.recovered}</p>
          <p class="text-xs text-gray-400 mt-1">{formatAmount(stats.revenueRecovered)} won back</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-5 border border-emerald-100">
          <p class="text-sm text-emerald-600 font-medium">Recovery Rate</p>
          <p class="text-2xl font-bold text-emerald-700 mt-1">{stats.recoveryRate}%</p>
          <p class="text-xs text-gray-400 mt-1">abandoned → recovered</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-5 border border-blue-100">
          <p class="text-sm text-blue-600 font-medium">In Progress</p>
          <p class="text-2xl font-bold text-blue-700 mt-1">{stats.started}</p>
          <p class="text-xs text-gray-400 mt-1">currently in checkout</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
          <p class="text-sm text-gray-500 font-medium">Expired</p>
          <p class="text-2xl font-bold text-gray-600 mt-1">{stats.expired}</p>
          <p class="text-xs text-gray-400 mt-1">closed/unsubscribed</p>
        </div>
      </div>

      <!-- Filters -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6 flex flex-wrap items-center gap-4">
        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-gray-600">Status:</label>
          <div class="flex gap-1">
            {['all', 'started', 'abandoned', 'recovered', 'completed', 'expired'].map((s) => (
              <a
                href={`?status=${s}&range=${dateRange}&page=1`}
                class={`px-3 py-1.5 rounded-lg text-sm font-medium transition ${
                  statusFilter === s
                    ? 'bg-[#01534d] text-white'
                    : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
