---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';

export const prerender = false;

// Get query params for filtering / detail view
const url = new URL(Astro.request.url);
const detailId = url.searchParams.get('id') || '';
const statusFilter = url.searchParams.get('status') || 'all';
const dateRange = url.searchParams.get('range') || '30d';
const page = parseInt(url.searchParams.get('page') || '1');
const perPage = 25;

// ─── Helpers ───
function formatDate(dateStr: string | null | undefined) {
  if (!dateStr) return '-';
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric',
    hour: '2-digit', minute: '2-digit',
    timeZone: 'America/New_York',
  });
}

function formatAmount(amount: number | string | null | undefined) {
  if (amount === null || amount === undefined || amount === '') return '-';
  const num = typeof amount === 'string' ? parseFloat(amount) : amount;
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num || 0);
}

function getStatusBadge(status: string) {
  switch (status) {
    case 'started': return 'bg-blue-100 text-blue-800';
    case 'abandoned': return 'bg-amber-100 text-amber-800';
    case 'recovered': return 'bg-green-100 text-green-800';
    case 'completed': return 'bg-teal-100 text-teal-800';
    case 'expired': return 'bg-gray-100 text-gray-600';
    default: return 'bg-gray-100 text-gray-800';
  }
}

function getRecoveryStepLabel(step: number) {
  if (!step || step === 0) return '-';
  return `${step}/5`;
}

function parseItems(raw: any) {
  try {
    return typeof raw === 'string' ? JSON.parse(raw) : (raw || []);
  } catch { return []; }
}

function buildBackParams() {
  const p = new URLSearchParams();
  if (statusFilter !== 'all') p.set('status', statusFilter);
  if (dateRange !== '30d') p.set('range', dateRange);
  if (page !== 1) p.set('page', String(page));
  const s = p.toString();
  return s ? `?${s}` : '';
}

// ═══════════════════════════════════════════════════════
// DETAIL VIEW (when ?id=XXX is set)
// ═══════════════════════════════════════════════════════
let detail: Record<string, any> | null = null;
let relatedDonations: Record<string, any>[] = [];
let lifetimeTotal = 0;
let derivedAddress: Record<string, string> | null = null;
let derivedPhone: string | null = null;
let lastAttemptedItems: any[] = [];
let lastAttemptedDonation: Record<string, any> | null = null;
let abandonedCartItems: any[] = [];

if (detailId) {
  const { data: row } = await supabaseAdmin
    .from('abandoned_checkouts')
    .select('*')
    .eq('id', detailId)
    .single();
  detail = row || null;

  // Items captured at the email-blur step. Mirrors donations.items shape.
  if (detail?.items) {
    abandonedCartItems = parseItems(detail.items);
  }

  if (detail?.email) {
    const normalizedEmail = detail.email.toLowerCase();
    const { data: donations } = await supabaseAdmin
      .from('donations')
      .select('id, amount, currency, status, donation_type, items, donor_name, donor_phone, campaign_name, campaign_slug, metadata, error_message, stripe_payment_intent_id, created_at, completed_at')
      .eq('donor_email', normalizedEmail)
      .order('created_at', { ascending: false })
      .limit(20);
    relatedDonations = donations || [];

    lifetimeTotal = relatedDonations
      .filter((d) => d.status === 'completed')
      .reduce((sum, d) => sum + (parseFloat(d.amount) || 0), 0);

    // Pull most-recent address + phone we have on file (any status)
    const withAddress = relatedDonations.find((d) => (d.metadata as any)?.billing_address);
    if (withAddress) {
      derivedAddress = (withAddress.metadata as any).billing_address;
    }
    derivedPhone = relatedDonations.find((d) => d.donor_phone)?.donor_phone || null;

    // Find the last donation attempt (pending/failed/completed) — that's what they tried to charge
    lastAttemptedDonation = relatedDonations[0] || null;
    if (lastAttemptedDonation) {
      lastAttemptedItems = parseItems(lastAttemptedDonation.items);
    }
  }
}

// ═══════════════════════════════════════════════════════
// LIST VIEW (only computed when not viewing detail)
// ═══════════════════════════════════════════════════════
let dateThreshold: Date | null = null;
if (dateRange === '7d') dateThreshold = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
else if (dateRange === '30d') dateThreshold = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
else if (dateRange === '90d') dateThreshold = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000);

let checkouts: Record<string, any>[] = [];
let count = 0;
let totalPages = 0;
let listError: any = null;
const stats = {
  total: 0, started: 0, abandoned: 0, recovered: 0, completed: 0, expired: 0,
  recoveryRate: 0, revenueRecovered: 0, revenueAbandoned: 0, revenueCompleted: 0,
};
const campaignBreakdown: Record<string, { count: number; revenue: number }> = {};
const paginationPages: number[] = [];
let showNextPage = false;
let showPagination = false;

if (!detailId) {
  let query = supabaseAdmin
    .from('abandoned_checkouts')
    .select('*', { count: 'exact' })
    .order('checkout_started_at', { ascending: false });

  if (statusFilter !== 'all') query = query.eq('status', statusFilter);
  if (dateThreshold) query = query.gte('checkout_started_at', dateThreshold.toISOString());

  const result = await query.range((page - 1) * perPage, page * perPage - 1);
  checkouts = result.data || [];
  count = result.count || 0;
  listError = result.error;
  totalPages = Math.ceil(count / perPage);

  // Stats
  let statsQuery = supabaseAdmin
    .from('abandoned_checkouts')
    .select('status, amount, recovered_at, campaign_type');
  if (dateThreshold) statsQuery = statsQuery.gte('checkout_started_at', dateThreshold.toISOString());
  const { data: statsData } = await statsQuery;

  stats.total = statsData?.length || 0;
  stats.started = statsData?.filter((d) => d.status === 'started').length || 0;
  stats.abandoned = statsData?.filter((d) => d.status === 'abandoned').length || 0;
  stats.recovered = statsData?.filter((d) => d.status === 'recovered').length || 0;
  stats.completed = statsData?.filter((d) => d.status === 'completed').length || 0;
  stats.expired = statsData?.filter((d) => d.status === 'expired').length || 0;

  const abandonedPlusRecovered = stats.abandoned + stats.recovered;
  stats.recoveryRate = abandonedPlusRecovered > 0
    ? Math.round((stats.recovered / abandonedPlusRecovered) * 100)
    : 0;
  stats.revenueRecovered = statsData?.filter((d) => d.status === 'recovered' && d.amount)
    .reduce((sum, d) => sum + (parseFloat(d.amount as any) || 0), 0) || 0;
  stats.revenueAbandoned = statsData?.filter((d) => d.status === 'abandoned' && d.amount)
    .reduce((sum, d) => sum + (parseFloat(d.amount as any) || 0), 0) || 0;
  stats.revenueCompleted = statsData?.filter((d) => d.status === 'completed' && d.amount)
    .reduce((sum, d) => sum + (parseFloat(d.amount as any) || 0), 0) || 0;

  statsData?.filter((d) => d.status === 'recovered').forEach((d) => {
    const key = ((d as any).campaign_type as string) || 'general';
    if (!campaignBreakdown[key]) campaignBreakdown[key] = { count: 0, revenue: 0 };
    campaignBreakdown[key].count++;
    campaignBreakdown[key].revenue += parseFloat(d.amount as any) || 0;
  });

  for (let i = 0; i < Math.min(totalPages, 5); i++) {
    const p = page <= 3 ? i + 1 : page + i - 2;
    if (p >= 1 && p <= totalPages) paginationPages.push(p);
  }
  showNextPage = page < totalPages;
  showPagination = totalPages > 1;
}

// ─── Campaigns for charge form (only when in detail view) ───
let campaigns: { slug: string; name: string; url_path: string | null }[] = [];
if (detailId) {
  const { data: c } = await supabaseAdmin
    .from('campaigns')
    .select('slug, name, url_path')
    .eq('is_active', true)
    .order('name');
  campaigns = c || [];
}

// Map slug → url_path so the in-site charge button redirects to the correct
// campaign page (campaigns use /<category>/<slug> or /<slug>, NOT /appeals/<slug>).
const campaignUrlMap: Record<string, string> = {};
for (const c of campaigns) {
  if (c.url_path) campaignUrlMap[c.slug] = c.url_path;
}

const fullName = detail ? [detail.first_name, detail.last_name].filter(Boolean).join(' ') : '';
const formattedAddress = derivedAddress
  ? [derivedAddress.line1, derivedAddress.line2, derivedAddress.city, derivedAddress.state, derivedAddress.postal_code, derivedAddress.country]
      .filter(Boolean).join(', ')
  : null;
---

<AdminLayout title={detail ? `Cart Recovery — ${fullName || detail.email}` : 'Cart Recovery'} activeNav="cart-recovery">
  {detail ? (
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- DETAIL VIEW                                            -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div>
      <a href={`/admin/abandoned-checkouts${buildBackParams()}`} class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-800 mb-4 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        Back to Cart Recovery
      </a>

      <!-- Header Card -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
        <div class="p-6">
          <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
            <!-- Left: Donor Info -->
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-full bg-[#01534d] flex items-center justify-center text-white text-lg font-bold">
                  {(fullName || detail.email || 'A').charAt(0).toUpperCase()}
                </div>
                <div>
                  <h1 class="text-xl font-bold text-gray-900">{fullName || 'Unknown Donor'}</h1>
                  <p class="text-sm text-gray-500">{detail.email}</p>
                </div>
                <span class={`ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold capitalize ${getStatusBadge(detail.status)}`}>
                  {detail.status}
                </span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                <div>
                  <span class="text-gray-400 text-xs uppercase tracking-wider">Email</span>
                  <p class="text-gray-800 font-medium break-all"><a href={`mailto:${detail.email}`} class="hover:underline">{detail.email}</a></p>
                </div>
                <div>
                  <span class="text-gray-400 text-xs uppercase tracking-wider">Phone</span>
                  <p class="text-gray-800 font-medium">
                    {detail.phone || derivedPhone ? (
                      <a href={`tel:${detail.phone || derivedPhone}`} class="hover:underline">{detail.phone || derivedPhone}</a>
                    ) : (
                      <span class="text-gray-300">Not provided</span>
                    )}
                    {!detail.phone && derivedPhone && <span class="ml-1 text-[10px] text-gray-400">(from prior donation)</span>}
                  </p>
                </div>
                <div class="sm:col-span-2">
                  <span class="text-gray-400 text-xs uppercase tracking-wider">Address</span>
                  <p class="text-gray-800">
                    {formattedAddress || <span class="text-gray-300">No address on file</span>}
                    {formattedAddress && <span class="ml-1 text-[10px] text-gray-400">(from prior donation)</span>}
                  </p>
                </div>
                <div>
                  <span class="text-gray-400 text-xs uppercase tracking-wider">Country</span>
                  <p class="text-gray-800">{detail.country || derivedAddress?.country || '-'}</p>
                </div>
                <div>
                  <span class="text-gray-400 text-xs uppercase tracking-wider">Lifetime Total</span>
                  <p class="text-gray-800 font-medium">{formatAmount(lifetimeTotal)}</p>
                </div>
                <div>
                  <span class="text-gray-400 text-xs uppercase tracking-wider">Checkout Started</span>
                  <p class="text-gray-800">{formatDate(detail.checkout_started_at)}</p>
                </div>
                <div>
                  <span class="text-gray-400 text-xs uppercase tracking-wider">Last Activity</span>
                  <p class="text-gray-800">{formatDate(detail.last_activity_at)}</p>
                </div>
                {detail.abandoned_at && (
                  <div>
                    <span class="text-gray-400 text-xs uppercase tracking-wider">Abandoned</span>
                    <p class="text-amber-700">{formatDate(detail.abandoned_at)}</p>
                  </div>
                )}
                {detail.recovered_at && (
                  <div>
                    <span class="text-gray-400 text-xs uppercase tracking-wider">Recovered</span>
                    <p class="text-green-700 font-medium">{formatDate(detail.recovered_at)}</p>
                  </div>
                )}
              </div>
            </div>

            <!-- Right: Amount + Actions -->
            <div class="lg:min-w-[280px]">
              <div class="text-right mb-4">
                <p class="text-xs text-gray-400 uppercase tracking-wider">Attempted Amount</p>
                <p class="text-3xl font-bold text-gray-900">{formatAmount(detail.amount)}</p>
                <p class="text-sm text-gray-500 mt-1 capitalize">{detail.campaign_slug?.replace(/-/g, ' ') || 'General'}</p>
              </div>

              <div class="flex flex-col gap-2 border-t border-gray-100 pt-4">
                {detail.resume_url && (
                  <button id="copy-resume-btn" data-url={detail.resume_url} class="w-full px-3 py-2 text-sm bg-blue-50 text-blue-700 border border-blue-200 rounded-lg hover:bg-blue-100 transition font-medium text-center flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    Copy Resume Link
                  </button>
                )}
                <a href="#charge-form" class="w-full px-3 py-2 text-sm bg-[#01534d] text-white rounded-lg hover:bg-[#01534d]/90 transition font-semibold text-center flex items-center justify-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8v8m0 0v.5m9-4.5a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  Quick Charge / Pay-by-Phone
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Charge Form -->
      <div id="charge-form" class="bg-white rounded-xl shadow-sm border border-emerald-200 mb-6">
        <div class="px-6 py-4 border-b border-emerald-100 bg-emerald-50/50 rounded-t-xl">
          <h2 class="text-sm font-semibold text-emerald-800 uppercase tracking-wider">Generate Pay-by-Phone Link</h2>
          <p class="text-xs text-emerald-700/80 mt-1">Edit the amount, generate a Stripe checkout link, and send it to the donor over the phone or via SMS.</p>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1.5 uppercase tracking-wider">Amount (USD)</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-medium">$</span>
                <input
                  id="charge-amount"
                  type="number"
                  step="1"
                  min="1"
                  value={detail.amount || ''}
                  class="w-full pl-7 pr-3 py-2.5 border border-gray-200 rounded-lg text-base font-semibold focus:ring-2 focus:ring-[#01534d]/30 focus:border-[#01534d]"
                  placeholder="100"
                />
              </div>
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-medium text-gray-600 mb-1.5 uppercase tracking-wider">Campaign</label>
              <select id="charge-campaign" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-[#01534d]/30 focus:border-[#01534d]">
                <option value={detail.campaign_slug || 'general'} selected>
                  {detail.campaign_slug
                    ? detail.campaign_slug.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())
                    : 'General Donation'} (current)
                </option>
                {campaigns.filter((c) => c.slug !== detail.campaign_slug).map((c) => (
                  <option value={c.slug}>{c.name}</option>
                ))}
                <option value="general">General Donation</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <button id="open-site-checkout-btn" class="px-5 py-3 bg-[#01534d] text-white rounded-lg hover:bg-[#01534d]/90 transition font-semibold flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9l9-7 9 7v11a2 2 0 01-2 2h-4M9 22V12h6v10M9 22H5a2 2 0 01-2-2V9z"></path></svg>
              Open on Our Checkout
            </button>
            <button id="generate-link-btn" class="px-5 py-3 bg-white border-2 border-[#01534d] text-[#01534d] rounded-lg hover:bg-[#01534d]/5 transition font-semibold flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
              Stripe-Hosted Link (for SMS)
            </button>
          </div>
          <p class="text-xs text-gray-500 mt-2">
            <span class="font-semibold text-[#01534d]">Open on Our Checkout</span>: opens the site checkout in a new tab with all donor info + amount pre-filled — admin enters card and submits.
            <br />
            <span class="font-semibold">Stripe-Hosted Link</span>: generates a 24-hr link to send to the donor via SMS so they can pay themselves.
          </p>

          <div id="link-result" class="hidden mt-5 p-4 bg-gray-50 rounded-lg border border-gray-200">
            <p class="text-xs text-gray-500 uppercase tracking-wider mb-2 font-semibold">Payment Link (valid for 24 hours)</p>
            <div class="flex items-center gap-2">
              <input id="generated-url" type="text" readonly class="flex-1 px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm font-mono text-gray-700" />
              <button id="copy-generated-link" class="px-4 py-2 bg-[#01534d] text-white rounded-lg hover:bg-[#01534d]/90 transition text-sm font-medium whitespace-nowrap">Copy</button>
              <a id="open-generated-link" href="#" target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition text-sm font-medium whitespace-nowrap">Open</a>
            </div>
            {detail.phone && (
              <a id="sms-link" href="#" class="inline-flex items-center gap-2 mt-3 text-sm text-blue-600 hover:underline">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                Open SMS to {detail.phone}
              </a>
            )}
          </div>

          <div id="link-error" class="hidden mt-3 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700"></div>

          {detail.admin_charge_link_url && (
            <div class="mt-4 pt-4 border-t border-gray-100 text-xs text-gray-500">
              <p class="font-medium text-gray-600">Last link generated: <span class="text-gray-500">{formatDate(detail.admin_charge_link_created_at)}</span> for <span class="font-semibold">{formatAmount(detail.admin_charge_link_amount)}</span></p>
            </div>
          )}
        </div>
      </div>

      <!-- Abandoned Cart Items (captured at email blur, before payment) -->
      {abandonedCartItems.length > 0 && (
        <div class="bg-white rounded-xl shadow-sm border border-amber-200 mb-6">
          <div class="px-6 py-4 border-b border-amber-100 bg-amber-50/40 rounded-t-xl flex items-center justify-between">
            <div>
              <h2 class="text-sm font-semibold text-amber-800 uppercase tracking-wider">Abandoned Cart</h2>
              <p class="text-xs text-amber-700/80 mt-1">What the donor had in their cart when they left.</p>
            </div>
            <span class="text-xs text-amber-700 font-medium">{abandonedCartItems.length} item{abandonedCartItems.length === 1 ? '' : 's'}</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="text-left px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Item</th>
                  <th class="text-left px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Campaign</th>
                  <th class="text-center px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Type</th>
                  <th class="text-center px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Qty</th>
                  <th class="text-right px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {abandonedCartItems.map((item: any) => (
                  <tr>
                    <td class="px-4 py-2">
                      <p class="font-medium text-gray-800">{item.name || item.label || 'Donation'}</p>
                      {item.childName && <p class="text-xs text-gray-400">Child: {item.childName}</p>}
                      {item.aqiqahFor && <p class="text-xs text-gray-400">For: {item.aqiqahFor}</p>}
                      {item.notes && <p class="text-xs text-gray-400">{item.notes}</p>}
                    </td>
                    <td class="px-4 py-2 text-gray-600 capitalize">{(item.campaign || '-').replace(/-/g, ' ')}</td>
                    <td class="px-4 py-2 text-center text-gray-600 capitalize">{item.type || 'single'}</td>
                    <td class="px-4 py-2 text-center text-gray-600">{item.quantity || 1}</td>
                    <td class="px-4 py-2 text-right font-semibold text-gray-800">{formatAmount((parseFloat(item.amount) || 0) * (item.quantity || 1))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- Last Donation Attempt -->
      {lastAttemptedDonation && (
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
          <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-gray-800 uppercase tracking-wider">Last Donation Attempt</h2>
            <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold capitalize ${
              lastAttemptedDonation.status === 'completed' ? 'bg-green-100 text-green-800'
              : lastAttemptedDonation.status === 'failed' ? 'bg-red-100 text-red-800'
              : lastAttemptedDonation.status === 'pending' ? 'bg-yellow-100 text-yellow-800'
              : 'bg-gray-100 text-gray-700'}`}>
              {lastAttemptedDonation.status || 'unknown'}
