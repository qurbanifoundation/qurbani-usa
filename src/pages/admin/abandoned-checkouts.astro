            </div>
          )}
        </div>
      </div>

      <!-- Donation History -->
      {relatedDonations.length > 0 && (
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
          <div class="px-6 py-4 border-b border-gray-100">
            <h2 class="text-sm font-semibold text-gray-800 uppercase tracking-wider">Donation History ({relatedDonations.length})</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="text-left px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Date</th>
                  <th class="text-left px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Campaign</th>
                  <th class="text-right px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Amount</th>
                  <th class="text-center px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Type</th>
                  <th class="text-center px-4 py-2 text-xs text-gray-500 font-semibold uppercase">Status</th>
                  <th class="text-right px-4 py-2 text-xs text-gray-500 font-semibold uppercase"></th>
