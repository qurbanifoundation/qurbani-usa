            {lastAttemptedDonation.stripe_payment_intent_id && (
              <a href={`https://dashboard.stripe.com/payments/${lastAttemptedDonation.stripe_payment_intent_id}`} target="_blank" rel="noopener noreferrer" class="inline-block mt-4 text-sm text-blue-600 hover:underline">
                View in Stripe Dashboard &rarr;
              </a>
            )}
          </div>
        </div>
      )}

      <!-- Source / UTMs -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
        <div class="px-6 py-4 border-b border-gray-100">
          <h2 class="text-sm font-semibold text-gray-800 uppercase tracking-wider">Source & Attribution</h2>
        </div>
        <div class="p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-sm">
          <div>
            <span class="text-gray-400 text-xs uppercase tracking-wider">Checkout Source</span>
            <p class="text-gray-800">{detail.checkout_source || '-'}</p>
          </div>
          <div>
            <span class="text-gray-400 text-xs uppercase tracking-wider">UTM Source</span>
            <p class="text-gray-800">{detail.utm_source || '-'}</p>
          </div>
          <div>
            <span class="text-gray-400 text-xs uppercase tracking-wider">UTM Medium</span>
            <p class="text-gray-800">{detail.utm_medium || '-'}</p>
          </div>
          <div>
            <span class="text-gray-400 text-xs uppercase tracking-wider">UTM Campaign</span>
            <p class="text-gray-800">{detail.utm_campaign || '-'}</p>
